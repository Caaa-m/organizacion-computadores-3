
class Board {
    field Array cells;     // las 100 casillas
    field int x0, y0;      // esquina superior izquierda del tablero (pixeles)
    field int rows, cols;  // dimensiones (10 x 10)
    field int mines;       // numero de minas (se ubicaran en el hito final)

    /** Crea el tablero y todas sus casillas a partir de la posicion (Ax, Ay). */
    constructor Board new(int Ax, int Ay) {
        var int r, c, size;
        let x0 = Ax;
        let y0 = Ay;
        let rows = 10;
        let cols = 10;
        let mines = 10;
        let size = Cell.size();
        let cells = Array.new(rows * cols);

        let r = 0;
        while (r < rows) {
            let c = 0;
            while (c < cols) {
                let cells[(r * cols) + c] = Cell.new(x0 + (c * size), y0 + (r * size), r, c);
                let c = c + 1;
            }
            let r = r + 1;
        }
        return this;
    }

    /** Dibuja el marco y luego cada casilla. */
    method void draw() {
        var int i;
        var Cell cell;
        do drawFrame();
        let i = 0;
        while (i < (rows * cols)) {
            let cell = cells[i];
            do cell.draw();
            let i = i + 1;
        }
        return;
    }

    /** Marco negro de 3 pixeles alrededor del tablero. */
    method void drawFrame() {
        var int w, h, x1, y1, x2, y2;
        let w = cols * Cell.size();   // 200 px
        let h = rows * Cell.size();   // 200 px
        let x1 = x0 - 4;
        let y1 = y0 - 4;
        let x2 = x0 + w + 3;
        let y2 = y0 + h + 3;

        do Screen.setColor(true);
        do Screen.drawRectangle(x1, y1, x2, y0 - 2);          // arriba
        do Screen.drawRectangle(x1, y0 + h + 1, x2, y2);      // abajo
        do Screen.drawRectangle(x1, y1, x0 - 2, y2);          // izquierda
        do Screen.drawRectangle(x0 + w + 1, y1, x2, y2);      // derecha
        return;
    }

    /** Devuelve la casilla en (r, c). */
    method Cell getCell(int r, int c) {
        return cells[(r * cols) + c];
    }

    method int getRows() { return rows; }
    method int getCols() { return cols; }
    method int getMines() { return mines; }

    /** Libera cada casilla, el arreglo y el propio tablero. */
    method void dispose() {
        var int i;
        var Cell cell;
        let i = 0;
        while (i < (rows * cols)) {
            let cell = cells[i];
            do cell.dispose();
            let i = i + 1;
        }
        do cells.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
